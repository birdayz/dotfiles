{
    "layer": "top",
    "position": "top",
    "height": 30,
    "modules-left": ["sway/workspaces", "sway/mode"],
    "modules-center": ["sway/window"],
    "modules-right": ["network", "cpu", "memory", "clock", "tray"],
    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": true
    },
    "sway/window": {
        "max-length": 70,
        "tooltip": false
    },
    "cpu": {
        "format": "CPU {usage}%",
        "tooltip": false
    },
    "memory": {
        "format": "RAM {percentage}%",
        "tooltip": false
    },
    "network": {
        "format-wifi": "Wi-Fi {signalStrength}%",
        "format-ethernet": "Ethernet",
        "format-disconnected": "Offline",
        "tooltip": false
    },
    "clock": {
        "format": "{:%Y-%m-%d %H:%M}",
        "tooltip-format": "{:%A, %d %B %Y}"
    },
    "tray": {
        "spacing": 10
    }
}
